{
  "name": "@lol-viewer/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm rebuild:native && electron-vite dev",
    "build": "pnpm rebuild:native && electron-vite build",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:test-native": "node scripts/rebuild-node-sqlite.cjs",
    "smoke:sqlite": "electron scripts/sqlite-smoke.cjs",
    "test": "pnpm rebuild:test-native && vitest run --configLoader runner",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm test && pnpm typecheck && pnpm rebuild:native && pnpm smoke:sqlite && electron-vite build"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^12.11.1",
    "electron": "^37.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.16.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron-vite": "^3.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "6.4.3",
    "vitest": "^3.2.4"
  }
}
